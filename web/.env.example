# AI on/off switch. false = free built-in mock answers (no tokens used), true = Gemini.
VITE_AI_ENABLED=false

# Server-only secret (no VITE_ prefix, so it is never sent to the browser).
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-flash-latest; falls back to gemini-flash-lite-latest when busy).
GEMINI_MODEL=

# Leave empty to use the dev server's /api/chat. Set to the backend URL once it exists.
VITE_API_URL=
