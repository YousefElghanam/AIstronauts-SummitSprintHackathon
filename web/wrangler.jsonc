{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amtsweg",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Output of `npm run build`.
    "directory": "./dist",
    "binding": "ASSETS",
    // vue-router uses history mode: unknown paths like /chat get index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker code; static files are served directly.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Secrets: npx wrangler secret put GEMINI_API_KEY
  // Optional plain var: "vars": { "GEMINI_MODEL": "gemini-flash-latest" }
}
